# Option Visualizer Backend Environment Variables

# Google Gemini API (required for screenshot OCR)
GEMINI_API_KEY=your_gemini_api_key

# Tastytrade API OAuth Credentials (required for accurate IV Rank)
# 1. Create OAuth app: https://my.tastytrade.com/app.html#/manage/api-access/oauth-applications
# 2. Generate refresh token: OAuth Applications > Manage > Create Grant
# Note: Sandbox accounts do NOT return market metrics data
TASTYTRADE_CLIENT_SECRET=your_client_secret
TASTYTRADE_REFRESH_TOKEN=your_refresh_token

# Optional: Override default values
# GEMINI_OCR_MODEL=gemini-3.1-flash-lite
# GEMINI_OCR_MAX_DIMENSION=1024
# DEFAULT_RISK_FREE_RATE=0.045
# DEFAULT_IMPLIED_VOLATILITY=0.25
# MARKET_DATA_CACHE_MINUTES=10

# Optional: conservative Tastytrade traffic controls and bounded caches
# TASTYTRADE_MAX_CONCURRENT_REQUESTS=2
# TASTYTRADE_MIN_REQUEST_INTERVAL_SECONDS=0.25
# TASTYTRADE_RATE_LIMIT_RETRIES=2
# TASTYTRADE_RATE_LIMIT_MAX_DELAY_SECONDS=30
# TASTYTRADE_SKEW_CACHE_SECONDS=300
# TASTYTRADE_SKEW_NEGATIVE_CACHE_SECONDS=45
# TASTYTRADE_SKEW_CACHE_MAX_ENTRIES=32
# TASTYTRADE_OPTION_CHAIN_CACHE_SECONDS=300
# TASTYTRADE_OPTION_CHAIN_CACHE_MAX_ENTRIES=32
# TASTYTRADE_GREEKS_CACHE_SECONDS=300
# TASTYTRADE_GREEKS_CACHE_MAX_ENTRIES=4096
